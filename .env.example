# Copy to .env (in the repo root) and fill in your keys.

# NVIDIA — objection classifier + debrief summary (Llama 3.3 70B), and in free
# mode also speech-to-text and the fallback voice. Free key:
# https://build.nvidia.com → any model → Get API Key
NVIDIA_API_KEY=nvapi-

# Voice provider: "free" (NVIDIA Riva + your voice cloned locally by
# voice-server/) or "elevenlabs" (paid). Defaults to elevenlabs when
# ELEVENLABS_API_KEY is set, otherwise free.
# VOICE_PROVIDER=free

# ElevenLabs — only needed when VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=

# Free mode — where the local voice server runs (npm run voice:start)
# VOICE_SERVER_URL=http://127.0.0.1:8005

# Free mode — NVIDIA Riva overrides (defaults use the hosted build.nvidia.com endpoints)
# NVIDIA_RIVA_ENDPOINT=grpc.nvcf.nvidia.com:443
# NVIDIA_ASR_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
# NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
# NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria

# Optional — PostHog product analytics
POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Optional — server port (the Vite dev proxy expects 3001)
# PORT=3001
