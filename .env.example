# Copy to .env (in the repo root) and fill in your keys.

# ElevenLabs — speech-to-text, voice cloning and text-to-speech
ELEVENLABS_API_KEY=

# NVIDIA NIM — objection classifier + debrief summary (Llama 3.3 70B)
# Get one at https://build.nvidia.com → any model → Get API Key
NVIDIA_API_KEY=nvapi-

# Optional — PostHog product analytics
POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Optional — server port (the Vite dev proxy expects 3001)
# PORT=3001
